# Local CI / vanilla Postgres tests (never a supabase.co URL in CI)
DATABASE_URL=postgres://ndapp:ndapp@127.0.0.1:5432/ndapp

# Hosted Supabase (server only — never VITE_ prefix on the service role)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
HOSTED_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# API process
PORT=3000
CORS_ORIGIN=https://your-app.vercel.app
SERVE_WEB=0
# APPLY_SCHEMA=1 is local/CI only. It is refused when DATABASE_URL is hosted.

# Browser (safe to ship; this is the publishable key)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
# Same-origin in production; local Vite proxies to :3000
VITE_API_URL=

# Optional: run hosted integration tests against a dedicated test project
# NDAPP_HOSTED_TESTS=1
